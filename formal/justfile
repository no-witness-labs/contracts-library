# Formal-verification pipeline. Run from this directory (`formal/`).
#
# Compile the Aiken validators (in ../onchain) into the blueprint `plutus.json`,
# copy one validator's compiled code from it to Scripts/, and re-check the Lean
# (Lean-Blaster) proofs against that code. The point of the copy step is that the
# proofs target the *actual compiled validator*, not a hand-written model.
#
# Lean v4.24.0 + Z3 4.15.2 come from ./flake.nix (`nix develop`); `aiken` must
# be on PATH. Run `just deps` once before the first `just verify`.

onchain   := "../onchain"
scripts   := "Scripts"

# Full pipeline: build -> cbor -> verify.
default: verify

# List recipes.
list:
    @just --list

# Fetch the Lean dependencies (Blaster). Run once, or after bumping its rev.
deps:
    nix develop --command lake update

# Compile the validators into ../onchain/plutus.json.
build:
    cd {{onchain}} && aiken build

# Write the compiledCode of one validator from the blueprint into
# Scripts/<module>.<validator>.cbor, where `#import_uplc` reads it. Only rewrites
# the file when its bytes change, and invalidates the Lake cache of any Lean
# module that reads it, so that `verify` re-checks it.

# Copy one validator's compiled code from the blueprint to Scripts/.
cbor validator plutus=(onchain / "plutus.json"): build
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p {{scripts}}
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    written="$(python3 -I scripts/process_blueprint.py "{{plutus}}" "{{validator}}" --cbor-only --scripts "$tmp")"
    file="$(basename "$written")"
    out="{{scripts}}/$file"
    if [ -e "$out" ] && cmp -s "$out" "$written"; then
      echo "  $out (unchanged)"
      exit 0
    fi
    echo "  $out (changed)"
    mv "$written" "$out"
    for lean in $(find Formal -name '*.lean' -exec grep -lF "Scripts/$file" {} +); do
      mod="${lean%.lean}"
      echo "    invalidate Lake cache for $mod (depends on $file)"
      rm -f .lake/build/lib/lean/"$mod".olean \
            .lake/build/lib/lean/"$mod".olean.hash \
            .lake/build/lib/lean/"$mod".ilean \
            .lake/build/lib/lean/"$mod".ilean.hash \
            .lake/build/lib/lean/"$mod".trace \
            .lake/build/ir/"$mod".c \
            .lake/build/ir/"$mod".c.hash \
            .lake/build/ir/"$mod".setup.json
    done

# Re-check every theorem. Runs inside the flake's shell (Lean v4.24.0 + Z3
# 4.15.2). Drop `nix develop --command` if the toolchain is already on PATH.
# Each contract with hand-written proofs adds its validator's `cbor` here.

# Re-check every Lean proof against the current compiled code (annotated lake output).
verify: (cbor "linear_vesting")
    nix develop --command bash -c 'set -o pipefail; lake build 2>&1 | awk -f scripts/annotate-blaster-logs.awk'

clean:
    rm -rf {{scripts}}
    nix develop --command lake clean

# Generate the universal checks of one validator into `folder` (see
# Formal/Universal/PROPERTIES.md): Types.lean, General.lean and Honest.lean are
# replaced on every run; Tx.lean, the honest transactions, is written only when it
# does not exist. `folder` is under Formal/, for example
# Formal/Vesting/Linear/Blueprint. Needs python3 (standard library only).

# Generate a validator's universal checks into a folder from a blueprint.
blueprint validator folder plutus=(onchain / "plutus.json"): (cbor validator plutus)
    python3 -I scripts/process_blueprint.py "{{plutus}}" "{{validator}}" --out "{{folder}}" --scripts {{scripts}}

# Build Formal.Universal and the folder's Types.lean and Tx.lean, then run Lean on
# its General.lean and Honest.lean, one proof at a time, with a limit of 120
# seconds for each file. `universal` runs inside the flake's shell;
# `universal-local` needs Lean v4.24.0, Z3 4.15.2 and gawk already on PATH.

# Re-check Formal.Universal and a folder's generated universal checks (annotated output).
universal folder:
    nix develop --command just universal-local "{{folder}}"

# The same as `universal`, with the toolchain on PATH instead of `nix develop`.
universal-local folder:
    #!/usr/bin/env bash
    set -euo pipefail
    prefix="$(echo "{{folder}}" | sed -e 's#/*$##' -e 's#/#.#g')"
    lake build Formal.Universal "$prefix.Types" "$prefix.Tx" 2>&1 | awk -f scripts/annotate-blaster-logs.awk
    for f in "{{folder}}/General.lean" "{{folder}}/Honest.lean"; do
      echo "universal checks: $f"
      set +e
      time timeout 120 lake env lean "$f" 2>&1 | awk -f scripts/annotate-blaster-logs.awk
      status=${PIPESTATUS[0]}
      set -e
      if [ "$status" -ne 0 ]; then
        echo "  $f: lean exited with status $status (124: the 120-second limit was reached)"
      fi
    done
