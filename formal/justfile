# Formal verification. Run from this directory (`formal/`); the conventions are in README.md.
#
# Needs Lean v4.24.0, Z3 4.15.2, gawk, python3 and `aiken` on PATH; run `just deps` once.
# With Nix, run any recipe as `nix develop --command just <recipe>`.

plutus := "../onchain/plutus.json"
# The validators with hand-written proofs, whose compiled code `verify` copies first.
proved := "linear_vesting"
run := "python3 -I -u scripts/universal.py"

default: verify

# List recipes.
list:
    @just --list

# Fetch the Lean dependencies. Run once, or after bumping a rev.
deps:
    lake update

# Delete the compiled code and the Lake build files.
clean:
    rm -rf Scripts
    lake clean

# Compile the validators into ../onchain/plutus.json.
build:
    cd ../onchain && aiken build

# Check all the hand-written Lean: Formal/Universal and every validator's proofs.
verify:
    {{run}} verify {{plutus}} {{proved}}

# Check the Lean in Formal/Universal.
universal:
    {{run}} build Formal.Universal

# One recipe per validator. No argument: its hand-written proofs. G or H<n>: one group of its
# universal checks (add --counterexamples, or --from-log to summarise the last run's log).
# Any other name: that file of its hand-written proofs, for example `just vesting Soundness`.

vesting *args:
    {{run}} run Formal/Vesting/Linear linear_vesting {{plutus}} {{args}}

# The sale example, whose blueprint is outside ../onchain: set the path to it here.
sale *args:
    {{run}} run Formal/Sale sale ../../sale/plutus.json {{args}}
