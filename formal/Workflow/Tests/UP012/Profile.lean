namespace Workflow.Tests.UP012.Profile

open Workflow Workflow.Generator

/-! Experimental vesting scenario from PR #55 at f5cbda7df624f2496dd2e6fe354a0cd15365b923.
The original artifact guard, typed data, and transaction shapes remain intact.
The candidate module supplies the single authoritative set of four propositions.
-/

private def referenceCompiledCode : String := ""

private def typesTemplate : String := r#"-- Generated by process_blueprint.py from the blueprint entry `linear_vesting.linear_vesting` (Aiken v1.1.22+39d6b04). Do not edit; regenerate.
import PlutusCore.UPLC
import CardanoLedgerApi
import Formal.Universal.Properties

namespace Formal.Vesting.Linear.Blueprint

open PlutusCore.Data (Data)
open PlutusCore.ByteString (ByteString)
open PlutusCore.UPLC.Term (Term Const Program)
open PlutusCore.UPLC.CekMachine (cekExecuteProgram State)
open CardanoLedgerApi.IsData.Class (IsData toTerm)
open CardanoLedgerApi.V3 (Address Credential StakingCredential ScriptContext TxOutRef)

/-! ## Types -/

/-- `vesting/types/VestedAsset` -/
structure Vesting.Types.VestedAsset where
  policy : ByteString
  name : ByteString
  total : Int

instance : IsData Vesting.Types.VestedAsset where
  toData x := Data.Constr 0 [Data.B x.policy, Data.B x.name, Data.I x.total]
  fromData
    | Data.Constr 0 [d0, d1, d2] => do
        let a0 ← (match d0 with | Data.B b1 => some b1 | _ => none)
        let a1 ← (match d1 with | Data.B b2 => some b2 | _ => none)
        let a2 ← (match d2 with | Data.I i3 => some i3 | _ => none)
        pure (Vesting.Types.VestedAsset.mk a0 a1 a2)
    | _ => none

/-- `vesting/types/VestingDatum` -/
structure Vesting.Types.VestingDatum where
  beneficiary : Credential
  locker : Credential
  vesting : List (Vesting.Types.VestedAsset)
  start_time : Int
  end_time : Int
  recovery_time : Int

instance : IsData Vesting.Types.VestingDatum where
  toData x := Data.Constr 0 [IsData.toData x.beneficiary, IsData.toData x.locker, Data.List ((x.vesting).map (fun v1 => IsData.toData v1)), Data.I x.start_time, Data.I x.end_time, Data.I x.recovery_time]
  fromData
    | Data.Constr 0 [d0, d1, d2, d3, d4, d5] => do
        let a0 ← (IsData.fromData d0 : Option Credential)
        let a1 ← (IsData.fromData d1 : Option Credential)
        let a2 ← (match d2 with | Data.List xs3 => xs3.mapM (fun v2 => (IsData.fromData v2 : Option Vesting.Types.VestedAsset)) | _ => none)
        let a3 ← (match d3 with | Data.I i4 => some i4 | _ => none)
        let a4 ← (match d4 with | Data.I i5 => some i5 | _ => none)
        let a5 ← (match d5 with | Data.I i6 => some i6 | _ => none)
        pure (Vesting.Types.VestingDatum.mk a0 a1 a2 a3 a4 a5)
    | _ => none

/-- `vesting/types/VestingRedeemer` -/
inductive Vesting.Types.VestingRedeemer where
  | Claim
  | Cancel

instance : IsData Vesting.Types.VestingRedeemer where
  toData
    | Vesting.Types.VestingRedeemer.Claim => Data.Constr 0 []
    | Vesting.Types.VestingRedeemer.Cancel => Data.Constr 1 []
  fromData
    | Data.Constr 0 [] => some Vesting.Types.VestingRedeemer.Claim
    | Data.Constr 1 [] => some Vesting.Types.VestingRedeemer.Cancel
    | _ => none

/-! ## Handlers -/

/-- Purposes with a handler in the blueprint (the `else` fallback is not listed). -/
def handlers : List String := ["spend"]

abbrev SpendDatum := Vesting.Types.VestingDatum
abbrev SpendRedeemer := Vesting.Types.VestingRedeemer

/-! ## Parameters and script -/

/-- The script's arguments: the script context only (no parameters). -/
def args (ctx : ScriptContext) : List Term := [toTerm ctx]

def program : Program := singleCborEncodedScriptFromHexM __COMPILED_CODE__

/-- The script hash recorded in the blueprint (hex). -/
def scriptHashHex : String := "95da21788eb1f59f51aad9669eb8c8b7081ab618c1f29b871925894a"

/-- The script accepts within `fuel` steps. -/
def accepts (fuel : Nat) (ctx : ScriptContext) : Prop :=
  cekExecuteProgram program (args ctx) fuel = .Halt (.VCon Const.Unit)

/-- The script genuinely fails within `fuel` steps (running out of steps is not a failure). -/
def rejects (fuel : Nat) (ctx : ScriptContext) : Prop :=
  Formal.Universal.Properties.rejectedWithin program (args ctx) fuel

end Formal.Vesting.Linear.Blueprint
"#

private def txTemplate : String := r#"-- The honest transactions for the checks in `Checks.lean`: for each action, a shape, that is a
-- transaction with a fixed structure whose leaves are the fields of a structure. Written once by
-- process_blueprint.py as a stub; it is never replaced, so edit it freely.
import CardanoLedgerApi
import Formal.Universal.Properties
import Formal.Vesting.Linear.Blueprint.Types

namespace Formal.Vesting.Linear.Blueprint

open PlutusCore.Data (Data)
open PlutusCore.ByteString (ByteString)
open CardanoLedgerApi.IsData.Class.IsData (toData)
open CardanoLedgerApi.V3 (ScriptContext)
open Formal.Universal.TxBuilder

/-- The policy of the vested asset. A literal: a symbolic policy stops Blaster inside
    `validScriptContext` (docs/Universal/DEAD_ENDS.md §17). -/
def vestedPolicy : ByteString := "policyA"

/-- The datum: one vested asset, key credentials for the beneficiary and the locker. -/
def vestingDatum (beneficiary locker name : ByteString) (total start finish recovery : Int) : Data :=
  toData
    ({ beneficiary := .PubKeyCredential beneficiary
       locker := .PubKeyCredential locker
       vesting := [{ policy := vestedPolicy, name := name, total := total }]
       start_time := start
       end_time := finish
       recovery_time := recovery } : Vesting.Types.VestingDatum)

/-! ## claim: the position and the signer's ada in; the position, with `kept` of the asset left,
back to the script, and the rest to the signer out; one signatory. -/

structure ClaimLeaves where
  beneficiary : ByteString
  locker : ByteString
  name : ByteString
  total : Int
  start : Int
  finish : Int
  recovery : Int
  script : ByteString
  prevTx : ByteString
  txId : ByteString
  scriptAda : Int
  feeInputAda : Int
  keptAda : Int
  kept : Int
  fee : Int
  now : Int
  signer : ByteString

def claim (p : ClaimLeaves) : ScriptContext :=
  let datum := vestingDatum p.beneficiary p.locker p.name p.total p.start p.finish p.recovery
  let position := input p.prevTx 0 (toScript p.script (adaAnd p.scriptAda vestedPolicy p.name p.total) datum)
  let feeInput := input p.prevTx 1 (toKey p.signer (ada p.feeInputAda))
  let continuation := toScript p.script (adaAnd p.keptAda vestedPolicy p.name p.kept) datum
  let change := p.scriptAda + p.feeInputAda - p.keptAda - p.fee
  let payout := toKey p.signer (adaAnd change vestedPolicy p.name (p.total - p.kept))
  Spend.context
    { own := position
      others := [feeInput]
      outputs := [continuation, payout]
      signatories := [p.signer]
      validFrom := p.now
      fee := p.fee
      txId := p.txId
      redeemer := toData Vesting.Types.VestingRedeemer.Claim }

/-! ## cancel: the position and the signer's ada in; everything to the signer out; one
signatory. -/

structure CancelLeaves where
  beneficiary : ByteString
  locker : ByteString
  name : ByteString
  total : Int
  start : Int
  finish : Int
  recovery : Int
  script : ByteString
  prevTx : ByteString
  txId : ByteString
  scriptAda : Int
  feeInputAda : Int
  fee : Int
  now : Int
  signer : ByteString

def cancel (p : CancelLeaves) : ScriptContext :=
  let datum := vestingDatum p.beneficiary p.locker p.name p.total p.start p.finish p.recovery
  let position := input p.prevTx 0 (toScript p.script (adaAnd p.scriptAda vestedPolicy p.name p.total) datum)
  let feeInput := input p.prevTx 1 (toKey p.signer (ada p.feeInputAda))
  let change := p.scriptAda + p.feeInputAda - p.fee
  let back := toKey p.signer (adaAnd change vestedPolicy p.name p.total)
  Spend.context
    { own := position
      others := [feeInput]
      outputs := [back]
      signatories := [p.signer]
      validFrom := p.now
      fee := p.fee
      txId := p.txId
      redeemer := toData Vesting.Types.VestingRedeemer.Cancel }

end Formal.Vesting.Linear.Blueprint
"#

private def render (source modulePrefix : String) : String :=
  source.replace "Formal.Vesting.Linear.Blueprint" modulePrefix

private def build (target : TargetDescription) (modulePrefix : String) : Except Error GenerationPlan := do
  unless target.plutusVersion == "v3" && (target.parameters.getD #[]).isEmpty &&
      target.compiledCode == referenceCompiledCode && target.declaredPurposes == #[.spend] do
    throw ⟨.unsupported,
      "UP-012 currently supports only the original unparameterized linear-vesting artifact from PR #55"⟩
  return {
    targetName := target.name
    modules := #[
      ⟨s!"{modulePrefix}.Types", render (typesTemplate.replace "__COMPILED_CODE__" (reprStr target.compiledCode)) modulePrefix⟩,
      ⟨s!"{modulePrefix}.Tx", render txTemplate modulePrefix⟩,
      Candidates.UP012.checks modulePrefix]
    jobs := Candidates.UP012.jobs modulePrefix
    notes := Candidates.UP012.notes }

/-- Run the original vesting candidate as a bounded experimental profile. -/
def provider : Provider := { id := "UP-012", generate := build }

end Workflow.Tests.UP012.Profile
