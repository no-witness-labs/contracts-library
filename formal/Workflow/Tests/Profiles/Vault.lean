import Workflow.Generator.Basic
import Formal.TxModels.Definitions.TxM009

namespace Workflow.Tests.Profiles.Vault

open Workflow Workflow.Generator

/-! Preparation for the two pinned vault artifacts in the UP001 fixture. -/

private def vaultCompiledCode : String := ""

private def buggyCompiledCode : String := "585c01010029800aba2aba1aab9eaab9dab9a4888896600264653001300600198031803800cc0180092225980099b8748008c01cdd500144c8cc892898050009805180580098041baa0028a51401830060013003375400d149a26cac8009"

private def knownArtifact (compiledCode : String) : Option (String × String) :=
  if compiledCode == vaultCompiledCode then
    some ("7ee33b926834bd7d983ca9d433cee0cc1918ed5bcb5f78ab795d7057", "pinned vault artifact")
  else if compiledCode == buggyCompiledCode then
    some ("5d0f747d4eb70739ff667eed99b934de3a3e5054fae1e368902078e3", "pinned buggy vault artifact")
  else none

private def typesTemplate : String := r#"-- Generated by Workflow.Tests.Profiles.Vault; do not edit this generated output.
-- Exact compiled artifacts are pinned by this test profile.
-- Accepted artifact: __ARTIFACT_LABEL__.
import PlutusCore.UPLC
import CardanoLedgerApi
import Formal.Universal.Properties

namespace Formal.Vault.Blueprint

open PlutusCore.Data (Data)
open PlutusCore.ByteString (ByteString)
open PlutusCore.UPLC.Term (Term Const Program)
open PlutusCore.UPLC.CekMachine (cekExecuteProgram State)
open CardanoLedgerApi.IsData.Class (IsData toTerm)
open CardanoLedgerApi.V3 (Address Credential StakingCredential ScriptContext TxOutRef)

/-! ## Parameters and script -/

/-- The script's arguments: the script context only (no parameters). -/
def args (ctx : ScriptContext) : List Term := [toTerm ctx]

def program : Program := singleCborEncodedScriptFromHexM __COMPILED_CODE__

/-- The known hash for the accepted compiled artifact (hex). -/
def scriptHashHex : String := __SCRIPT_HASH__

/-- The script accepts within `fuel` steps. -/
def accepts (fuel : Nat) (ctx : ScriptContext) : Prop :=
  cekExecuteProgram program (args ctx) fuel = .Halt (.VCon Const.Unit)

/-- The script genuinely fails within `fuel` steps (running out of steps is not a failure). -/
def rejects (fuel : Nat) (ctx : ScriptContext) : Prop :=
  Formal.Universal.Properties.rejectedWithin program (args ctx) fuel

end Formal.Vault.Blueprint
"#

private def txTemplate : String := r#"-- Generated by Workflow.Tests.Profiles.Vault; do not edit this generated output.
import Formal.TxModels.Definitions.TxM009
import Formal.Vault.Blueprint.Types

namespace Formal.Vault.Blueprint

abbrev SpendLeaves := Formal.TxModels.TxM009.SpendLeaves
abbrev spend := Formal.TxModels.TxM009.spend

end Formal.Vault.Blueprint
"#

private def render (source modulePrefix : String) : String :=
  source.replace "Formal.Vault.Blueprint" modulePrefix

/-- Prepare one exact vault artifact and its native spend model. -/
def support (target : TargetDescription) (modulePrefix : String) :
    Except Error (Array GeneratedModule) := do
  let unsupported : Error := ⟨.unsupported,
    "vault test profile supports only the two pinned unparameterized v3 vault artifacts with declared spend purpose"⟩
  unless target.plutusVersion == "v3" && (target.parameters.getD #[]).isEmpty &&
      target.declaredPurposes == #[.spend] do
    throw unsupported
  let some (scriptHash, artifactLabel) := knownArtifact target.compiledCode
    | throw unsupported
  let types := typesTemplate.replace "__COMPILED_CODE__" (reprStr target.compiledCode)
  let types := types.replace "__SCRIPT_HASH__" (reprStr scriptHash)
  let types := types.replace "__ARTIFACT_LABEL__" artifactLabel
  return #[
    ⟨s!"{modulePrefix}.Types", render types modulePrefix⟩,
    ⟨s!"{modulePrefix}.Tx", render txTemplate modulePrefix⟩]

end Workflow.Tests.Profiles.Vault
