private def checksTemplate : String := r#"-- Generated by Candidates.UP012; do not edit this generated output.
-- Original source: process_blueprint.py, PR #55 at f5cbda7df624f2496dd2e6fe354a0cd15365b923, blueprint entry `linear_vesting.linear_vesting` (Aiken v1.1.22+39d6b04).
import Blaster
import Formal.Universal.Properties
import Formal.Vesting.Linear.Blueprint.Types
import Formal.Vesting.Linear.Blueprint.Tx

-- Check one proof at a time, in order: Lean prints each result as it
-- comes, and a slow check cannot hold up the ones before it.
set_option Elab.async false

namespace Formal.Vesting.Linear.Blueprint

open PlutusCore.Data (Data)
open PlutusCore.ByteString (ByteString)
open CardanoLedgerApi.IsData.Class (IsData)
open CardanoLedgerApi.V3 (Address Credential PubKeyHash StakingCredential TxOutRef validScriptContext)
open Formal.Universal.Properties

/-- A `claim` transaction with its first signatory removed is rejected. Every signatory key is a
    leaf, so this covers removing any one. -/
theorem dropSigner_claim :
    ∀ p,
      validScriptContext (claim p) = true →
      accepts ledgerFuel (claim p) →
      (signatoriesOf (claim p)) ≠ [] →
      validScriptContext (withSignatories (claim p) (signatoriesOf (claim p)).tail) = true →
      rejects ledgerFuel (withSignatories (claim p) (signatoriesOf (claim p)).tail) := by blaster

/-- `dropSigner_claim` applies: some valid accepted `claim` transaction gives a valid changed
    transaction, so the check above does not hold only vacuously. -/
theorem dropSigner_claim_applies :
    ∃ p,
      validScriptContext (claim p) = true ∧
      accepts ledgerFuel (claim p) ∧
      (signatoriesOf (claim p)) ≠ [] ∧
      validScriptContext (withSignatories (claim p) (signatoriesOf (claim p)).tail) = true
        := by blaster

/-- A `cancel` transaction with its first signatory removed is rejected. Every signatory key is a
    leaf, so this covers removing any one. -/
theorem dropSigner_cancel :
    ∀ p,
      validScriptContext (cancel p) = true →
      accepts ledgerFuel (cancel p) →
      (signatoriesOf (cancel p)) ≠ [] →
      validScriptContext (withSignatories (cancel p) (signatoriesOf (cancel p)).tail) = true →
      rejects ledgerFuel (withSignatories (cancel p) (signatoriesOf (cancel p)).tail) := by blaster

/-- `dropSigner_cancel` applies: some valid accepted `cancel` transaction gives a valid changed
    transaction, so the check above does not hold only vacuously. -/
theorem dropSigner_cancel_applies :
    ∃ p,
      validScriptContext (cancel p) = true ∧
      accepts ledgerFuel (cancel p) ∧
      (signatoriesOf (cancel p)) ≠ [] ∧
      validScriptContext (withSignatories (cancel p) (signatoriesOf (cancel p)).tail) = true
        := by blaster

end Formal.Vesting.Linear.Blueprint
"#

private def scope : String :=
  "Experimental PR #55 vesting profile only: Claim and Cancel shapes each have one signer. " ++
  "Remove the first signer; preserve ledger-validity premises and the 1,000,000-step bound. " ++
  "Removal requires bounded explicit rejection; applicability is checked separately."

private def names : Array String :=
  #["dropSigner_claim", "dropSigner_claim_applies", "dropSigner_cancel", "dropSigner_cancel_applies"]

private def statement (name : String) : String :=
  let body := (checksTemplate.splitOn s!"theorem {name} :")[1]?.getD ""
  ((body.splitOn ":= by blaster").head?.getD "").trim

private def render (source modulePrefix : String) : String :=
  source.replace "Formal.Vesting.Linear.Blueprint" modulePrefix

/-- Render the original four candidate propositions in the caller's namespace. -/
def checks (modulePrefix : String) : GeneratedModule :=
  { name := s!"{modulePrefix}.Checks", source := render checksTemplate modulePrefix }

/-- Describe the original property and applicability jobs without changing their expectations. -/
def jobs (modulePrefix : String) : Array CheckJob :=
  names.map fun name =>
    { propertyId := "UP-012", name, moduleName := s!"{modulePrefix}.Checks",
      statement := statement name, expected := .valid, scope : CheckJob }

def notes : Array String :=
  #[scope, "All four jobs, including both applicability statements, must match their declared expectations."]

end Candidates.UP012
